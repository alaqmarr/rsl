# Core (Strict Port Range 4500-4600 across Local Dev & Oracle Cloud Ubuntu)
# Primary Domain & Wildcard Client Subdomains (rapidshiftlabs.in, *.tally.rapidshiftlabs.in, *.api.rapidshiftlabs.in)
NODE_ENV=development
PRIMARY_DOMAIN=rapidshiftlabs.in
APP_SUBDOMAIN=app
ADMIN_SUBDOMAIN=admin
DOCS_SUBDOMAIN=docs
SETUP_SUBDOMAIN=setup
TALLY_SUBDOMAIN=
TALLY_WILDCARD_ZONE=tally
API_WILDCARD_ZONE=api
SSL_CERT_DIR=.rsl-data/ssl
SSL_ACME_EMAIL=ssl-ops@rapidshiftlabs.in
SSL_PROVISION_MODE=auto
SSL_PROVISION_COMMAND=
SETUP_URL=http://localhost:4501/setup
SETUP_BOOTSTRAP_TOKEN=
APP_URL=http://localhost:4500
ADMIN_URL=http://localhost:4501
DOCS_URL=http://localhost:4502
WORKER_HEALTH_PORT=4510
CLEANUP_SERVICE_PORT=4520
LOG_LEVEL=info

# Data directories (local block storage on Oracle Ubuntu: /var/lib/rsl; local dev resolves relative to repo root)
DATA_DIR=.rsl-data
LOG_DIR=.rsl-logs
BACKUP_STAGING_DIR=.rsl-data/staging
TENANT_DB_MAX_OPEN=200
TENANT_DB_IDLE_CLOSE_MS=300000

# Redis (optional on local dev — uses SQLite durable queue runner when empty; on Oracle Ubuntu host uses dedicated port 4579: redis://127.0.0.1:4579)
REDIS_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4500
ADMIN_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption (32-byte base64 keys)
KMS_MASTER_KEY=
KMS_KEY_VERSION=1
BACKUP_SIGNING_KEY=
BACKUP_SIGNING_KEY_VERSION=1
API_KEY_PEPPER=

# Meta
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_CONFIG_ID=

# Google Business Profile and Drive backup
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GDRIVE_BACKUP_CLIENT_ID=
GDRIVE_BACKUP_CLIENT_SECRET=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Platform storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC=
R2_BUCKET_PLATFORM_BACKUP=
R2_PUBLIC_BASE_URL=

# Email (Nodemailer + Gmail SMTP)
EMAIL_FROM="RSL Marketing <your-account@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Observability (Sentry — org: al-aqmar)
SENTRY_ORG=al-aqmar
SENTRY_DSN_WEB=
SENTRY_DSN_ADMIN=
SENTRY_DSN_DOCS=
SENTRY_DSN_WORKER=
NEXT_PUBLIC_SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_DSN_DOCS=
OTEL_EXPORTER_OTLP_ENDPOINT=
